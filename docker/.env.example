# Cairn instance configuration. Copy to .env next to compose.yml.

# The address people use to reach this site. All absolute links are built from it.
CAIRN_PUBLIC_URL=https://example.com

# Generate both with: openssl rand -hex 32
CAIRN_SECRET=
POSTGRES_PASSWORD=

# production or staging. Staging is hidden from search engines and AI crawlers.
CAIRN_ENV=production

# Image version. Pin a release (for example 0.1) to control upgrades.
CAIRN_TAG=latest

# Where web is published on the host. Ignored by the Caddy profile, which
# publishes 80 and 443 itself.
CAIRN_HTTP_BIND=127.0.0.1:3000

# Apply database migrations when the api starts.
CAIRN_AUTO_MIGRATE=true

# The request header your reverse proxy puts the visitor's address in. Rate
# limits and the audit log use it. Pick a header the proxy overwrites, never
# one it appends to: x-forwarded-for with the Caddy profile, x-real-ip behind
# nginx (proxy_set_header X-Real-IP $remote_addr), cf-connecting-ip behind
# Cloudflare. Empty: the address web's socket sees.
CAIRN_CLIENT_IP_HEADER=

# Email. Without it, invitations are shared as links and email sign-in and
# password resets are off. Owners can also set this up, or override it, in
# Studio → Settings.
#   none        no email
#   log         print each email to the worker log (development)
#   smtp        CAIRN_SMTP_URL=smtps://user:password@smtp.example.com:465
#   aliyun-dm   Alibaba Cloud DirectMail with an AccessKey
CAIRN_MAIL_DRIVER=none
CAIRN_MAIL_FROM=
CAIRN_MAIL_FROM_NAME=
CAIRN_MAIL_REPLY_TO=
CAIRN_SMTP_URL=
CAIRN_ALIYUN_DM_REGION=cn-hangzhou
CAIRN_ALIYUN_DM_ACCESS_KEY_ID=
CAIRN_ALIYUN_DM_ACCESS_KEY_SECRET=
# Comma-separated addresses or @domains. When set, mail to anyone else is
# dropped. Use it on staging so test runs never reach real people.
CAIRN_MAIL_ALLOWED_RECIPIENTS=

# Sign in with GitHub. Create an OAuth app with the callback URL
# <CAIRN_PUBLIC_URL>/api/auth/callback/github. Set both or neither.
CAIRN_GITHUB_CLIENT_ID=
CAIRN_GITHUB_CLIENT_SECRET=
