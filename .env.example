# Local development. Copy to .env; both apps read it.

CAIRN_ENV=development
CAIRN_PUBLIC_URL=http://localhost:3000
CAIRN_SECRET=dev-only-secret-not-for-production-use
DATABASE_URL=postgres://cairn:cairn@localhost:54329/cairn

# api
CAIRN_API_PORT=4000
CAIRN_ROLES=api,worker
CAIRN_AUTO_MIGRATE=true

# Print email to the api log instead of sending it. See docker/.env.example
# for SMTP, Alibaba Cloud DirectMail and GitHub sign-in.
CAIRN_MAIL_DRIVER=log

# web
CAIRN_API_ORIGIN=http://localhost:4000
