{
  "name": "@cairnhq/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "migrate": "tsx --env-file-if-exists=../../.env src/main.ts migrate",
    "build": "tsdown",
    "start": "node dist/main.mjs",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@hono/zod-openapi": "^1.6.3",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "pg": "^8.23.1",
    "pg-boss": "^12.35.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cairnhq/contracts": "workspace:*",
    "@cairnhq/db": "workspace:*",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
